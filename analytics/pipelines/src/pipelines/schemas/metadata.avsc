{
  "type": "record",
  "name": "metadata",
  "namespace": "lake",
  "doc": "Columns the pipeline adds to the lake tables, shared by every layer: metadata columns start with an underscore; key and value are the raw Kafka record that quarantine tables keep",
  "fields": [
    {
      "name": "_record_source",
      "type": "string",
      "doc": "Kafka topic the change event was read from"
    },
    {
      "name": "_source_partition",
      "type": "int",
      "doc": "Kafka partition of the record"
    },
    {
      "name": "_source_offset",
      "type": "long",
      "doc": "Offset of the record in its Kafka partition"
    },
    {
      "name": "_published_at",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Kafka record timestamp (UTC); the table is partitioned by its day"
    },
    {
      "name": "_change_op",
      "type": "string",
      "doc": "Kind of change: create, update, delete or snapshot (Debezium op c, u, d or r)"
    },
    {
      "name": "_commit_sequence",
      "type": "long",
      "doc": "Position of the change in the source's commit log (Debezium source.lsn); increases in commit order"
    },
    {
      "name": "_changed_at",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Time the change was committed in the source database (Debezium source.ts_ms)"
    },
    {
      "name": "_captured_at",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Time Debezium processed the change (envelope ts_ms)"
    },
    {
      "name": "_content_hash",
      "type": "string",
      "doc": "Hex SHA-256 of the content columns (key and audit columns excluded); unchanged content keeps its hash"
    },
    {
      "name": "_landing_file",
      "type": "string",
      "doc": "Path of the landing Avro file the record was read from"
    },
    {
      "name": "_failure_reason",
      "type": "string",
      "doc": "First validation check the record failed"
    },
    {
      "name": "_quarantined_at",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Processing time of the micro-batch that quarantined the record"
    },
    {
      "name": "_valid_from",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Time this version of the row became current: the change's commit time in the source"
    },
    {
      "name": "_valid_to",
      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
      "default": null,
      "doc": "Time the next version of the row replaced this one; null while this version is current"
    },
    {
      "name": "_is_current",
      "type": "boolean",
      "doc": "Whether this is the latest version of the row"
    },
    {
      "name": "_is_deleted",
      "type": "boolean",
      "doc": "Whether the row was deleted in the source; the version keeps its last known values"
    },
    {
      "name": "key",
      "type": ["null", "string"],
      "default": null,
      "doc": "Raw Kafka record key, as text"
    },
    {
      "name": "value",
      "type": "string",
      "doc": "Raw Kafka record value, as text"
    }
  ]
}
