{
  "type": "record",
  "name": "current_orders",
  "namespace": "gold",
  "doc": "Latest version of every order, deleted ones included",
  "public_doc": "Latest version of every order not deleted in the source; read by the business questions",
  "fields": [
    {
      "name": "order_id",
      "type": "long",
      "from": "orders.order_id"
    },
    {
      "name": "status_key",
      "type": "int",
      "doc": "Current order status (dim_order_status key)"
    },
    {
      "name": "customer_id",
      "type": ["null", "long"],
      "default": null,
      "from": "orders.customer_id"
    },
    {
      "name": "order_date",
      "type": ["null", {"type": "int", "logicalType": "date"}],
      "default": null,
      "from": "orders.order_date"
    },
    {
      "name": "delivery_date",
      "type": ["null", {"type": "int", "logicalType": "date"}],
      "default": null,
      "from": "orders.delivery_date"
    },
    {
      "name": "order_date_key",
      "type": ["null", "int"],
      "default": null,
      "from": "gold.fact_order_history.order_date_key"
    },
    {
      "name": "delivery_date_key",
      "type": ["null", "int"],
      "default": null,
      "from": "gold.fact_order_history.delivery_date_key"
    },
    {
      "name": "_commit_sequence",
      "type": "long",
      "doc": "Position of the change in the source's commit log (Debezium source.lsn); increases in commit order"
    },
    {
      "name": "_changed_at",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Time the change was committed in the source database (Debezium source.ts_ms)"
    },
    {
      "name": "_is_deleted",
      "type": "boolean",
      "doc": "Whether the row was deleted in the source; the version keeps its last known values"
    }
  ]
}
