{
  "type": "record",
  "name": "fact_order_item_history",
  "namespace": "gold",
  "doc": "Order item history: one row per change to an order item from silver, unchanged versions and deletes included, with its business keys and its fold flag, version number, validity and current flag recomputed from all changes of the item; partitioned by month of _changed_at in PostgreSQL",
  "public_doc": "Order item history: one row per change to an order item, without unchanged versions, with the range in which it was the latest version and the product version valid when it changed; a delete is the last row and is never current",
  "fields": [
    {
      "name": "order_item_id",
      "type": "long",
      "from": "order_items.order_item_id"
    },
    {
      "name": "_commit_sequence",
      "type": "long",
      "doc": "Position of the change in the source's commit log (Debezium source.lsn); increases in commit order"
    },
    {
      "name": "_changed_at",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Time the change was committed in the source database (Debezium source.ts_ms)"
    },
    {
      "name": "_change_op",
      "type": "string",
      "doc": "Kind of change: create, update, delete or snapshot (Debezium op c, u, d or r)"
    },
    {
      "name": "order_id",
      "type": ["null", "long"],
      "default": null,
      "from": "order_items.order_id"
    },
    {
      "name": "product_id",
      "type": ["null", "long"],
      "default": null,
      "from": "order_items.product_id"
    },
    {
      "name": "product_key",
      "type": ["null", "long"],
      "default": null,
      "doc": "Product version valid at _changed_at, or the product's first version for an earlier change (dim_product key), resolved when the view is read; null while the product is not known yet, or once it is deleted",
      "view_only": true
    },
    {
      "name": "product_name",
      "type": ["null", "string"],
      "default": null,
      "doc": "Name of the product version product_key names",
      "view_only": true
    },
    {
      "name": "quantity",
      "type": ["null", "int"],
      "default": null,
      "from": "order_items.quantity"
    },
    {
      "name": "unit_price",
      "type": ["null", {"type": "bytes", "logicalType": "decimal", "precision": 38, "scale": 10}],
      "default": null,
      "doc": "Unit price of the product version product_key names: the price the order was placed at",
      "view_only": true
    },
    {
      "name": "line_amount",
      "type": ["null", {"type": "bytes", "logicalType": "decimal", "precision": 38, "scale": 10}],
      "default": null,
      "doc": "quantity × unit_price",
      "view_only": true
    },
    {
      "name": "_content_hash",
      "type": "string",
      "doc": "Hex SHA-256 of the content columns (key and audit columns excluded); unchanged content keeps its hash"
    },
    {
      "name": "_is_deleted",
      "type": "boolean",
      "doc": "Whether the row was deleted in the source; the version keeps its last known values"
    },
    {
      "name": "_is_folded",
      "type": "boolean",
      "doc": "Whether this version repeats the content and deletion state of the previous one by _commit_sequence, so it is not a version of its own and ends with the version it repeats"
    },
    {
      "name": "_version_number",
      "type": "long",
      "doc": "Number of the version among the row's versions in _commit_sequence order, from 1; a folded version shares the number of the version it repeats"
    },
    {
      "name": "_valid_to",
      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
      "default": null,
      "doc": "Time the next version of the row replaced this one; null while this version is current"
    },
    {
      "name": "_is_current",
      "type": "boolean",
      "doc": "Whether this is the latest version of the row"
    }
  ]
}
