-- Measured from the data, so it ages while the source is idle even when the pipeline is healthy.
CREATE OR REPLACE VIEW gold.data_freshness AS
SELECT 'customers' AS entity, max(_valid_from) AS last_changed_at FROM gold_internal.dim_customer
UNION ALL
SELECT 'products', max(_valid_from) FROM gold_internal.dim_product
UNION ALL
SELECT 'orders', max(_changed_at) FROM gold_internal.current_orders
UNION ALL
SELECT 'order_items', max(_changed_at) FROM gold_internal.current_order_items;

{{ describe_view(tables.data_freshness) }}

CREATE OR REPLACE VIEW gold.open_orders_by_delivery_date_and_status AS
SELECT
    o.delivery_date,
    s.status_code,
    count(*) AS open_orders
FROM gold.open_orders AS o
JOIN gold.dim_order_status AS s ON s.status_key = o.status_key
GROUP BY o.delivery_date, s.status_code;

{{ describe_view(tables.open_orders_by_delivery_date_and_status) }}

CREATE OR REPLACE VIEW gold.top_delivery_dates_by_open_orders AS
SELECT delivery_date, open_orders
FROM (
    SELECT
        o.delivery_date,
        count(*) AS open_orders,
        rank() OVER (ORDER BY count(*) DESC) AS place
    FROM gold.open_orders AS o
    GROUP BY o.delivery_date
) AS ranked_dates
WHERE place <= 3;

{{ describe_view(tables.top_delivery_dates_by_open_orders) }}

CREATE OR REPLACE VIEW gold.pending_items_by_product AS
SELECT
    i.product_id,
    count(*) AS pending_items,
    sum(i.quantity) AS pending_quantity
FROM gold.current_order_items AS i
JOIN gold.open_orders AS o ON o.order_id = i.order_id
GROUP BY i.product_id;

{{ describe_view(tables.pending_items_by_product) }}

CREATE OR REPLACE VIEW gold.top_customers_by_pending_orders AS
SELECT
    top_customers.customer_id,
    c.customer_name,
    top_customers.pending_orders
FROM (
    SELECT
        o.customer_id,
        count(*) AS pending_orders,
        rank() OVER (ORDER BY count(*) DESC) AS place
    FROM gold.open_orders AS o
    GROUP BY o.customer_id
) AS top_customers
LEFT JOIN gold.dim_customer AS c
    ON c.customer_id = top_customers.customer_id AND c._is_current
WHERE top_customers.place <= 3;

{{ describe_view(tables.top_customers_by_pending_orders) }}

