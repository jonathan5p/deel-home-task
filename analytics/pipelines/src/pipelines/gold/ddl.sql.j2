-- A change whose content hash and deletion state equal the previous change's is folded away
-- here, at read time, rather than flagged in the table: a late change landing between two
-- equal ones turns the later one back into a real change without rewriting history.
CREATE OR REPLACE VIEW gold.fact_order_history AS
WITH changes AS (
    SELECT
        *,
        (_content_hash, _is_deleted) IS NOT DISTINCT FROM
            (lag(_content_hash) OVER by_order, lag(_is_deleted) OVER by_order) AS is_folded
    FROM gold_internal.fact_order_history
    WINDOW by_order AS (PARTITION BY order_id ORDER BY _commit_sequence)
)
SELECT
    order_id,
    _changed_at,
    _change_op,
    status_key,
    customer_id,
    customer_key,
    order_date_key,
    delivery_date_key,
    lead(_changed_at) OVER versions AS _valid_to,
    lead(_changed_at) OVER versions IS NULL AND NOT _is_deleted AS _is_current
FROM changes
WHERE NOT is_folded
WINDOW versions AS (PARTITION BY order_id ORDER BY _commit_sequence);

{{ describe_view(
    tables.fact_order_history,
    tables.dim_customer_versions.column("_valid_to"),
    tables.dim_customer_versions.column("_is_current"),
) }}

CREATE OR REPLACE VIEW gold.fact_order_item_history AS
WITH changes AS (
    SELECT
        *,
        (_content_hash, _is_deleted) IS NOT DISTINCT FROM
            (lag(_content_hash) OVER by_item, lag(_is_deleted) OVER by_item) AS is_folded
    FROM gold_internal.fact_order_item_history
    WINDOW by_item AS (PARTITION BY order_item_id ORDER BY _commit_sequence)
)
SELECT
    order_item_id,
    _changed_at,
    _change_op,
    order_id,
    product_id,
    product_key,
    quantity,
    unit_price,
    line_amount,
    lead(_changed_at) OVER versions AS _valid_to,
    lead(_changed_at) OVER versions IS NULL AND NOT _is_deleted AS _is_current
FROM changes
WHERE NOT is_folded
WINDOW versions AS (PARTITION BY order_item_id ORDER BY _commit_sequence);

{{ describe_view(
    tables.fact_order_item_history,
    tables.dim_customer_versions.column("_valid_to"),
    tables.dim_customer_versions.column("_is_current"),
