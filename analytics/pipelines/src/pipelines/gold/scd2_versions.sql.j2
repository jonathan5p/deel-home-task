{#
    Every stored version with its fold flag and validity, from all of its key's versions in
    _commit_sequence order.

    A version is folded when its content hash and deletion state equal the previous
    version's; the first version's lag is null and its hash is not, so it never is. Each
    version that is not folded starts a new version_number and a folded one shares the
    number of the version it repeats, so it ends when that version ends: _valid_to is the
    _valid_from of the first row of the next number. The last number is current unless it is
    a delete, and a folded row never is.

    Every window is partitioned by the key, so a filter on the key reaches the table's
    (key, _commit_sequence) index instead of computing every key's versions.
#}
SELECT
{% for column in columns %}
    {{ column }},
{% endfor %}
    _is_folded,
    max(_valid_from) FILTER (WHERE NOT _is_folded) OVER (
        PARTITION BY {{ key }} ORDER BY version_number RANGE BETWEEN 1 FOLLOWING AND 1 FOLLOWING
    ) AS _valid_to,
    NOT _is_folded
        AND NOT _is_deleted
        AND version_number = max(version_number) OVER (PARTITION BY {{ key }}) AS _is_current
FROM (
    SELECT
        *,
        count(*) FILTER (WHERE NOT _is_folded) OVER (
            PARTITION BY {{ key }} ORDER BY _commit_sequence
        ) AS version_number
    FROM (
        SELECT
            *,
            (_content_hash, _is_deleted) IS NOT DISTINCT FROM
                (lag(_content_hash) OVER by_key, lag(_is_deleted) OVER by_key) AS _is_folded
        FROM {{ relation }}
        WINDOW by_key AS (PARTITION BY {{ key }} ORDER BY _commit_sequence)
    ) AS flagged
) AS numbered
