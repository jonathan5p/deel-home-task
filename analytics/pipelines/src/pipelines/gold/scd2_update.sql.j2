{#
    Recomputes the fold flag, _valid_to and _is_current of every stored version of each key
    the staged batch touches, from all of the key's versions in _commit_sequence order, then
    applies them to the current versions that stop being current (`closing`) or to every
    other version whose values change.

    A version is folded when its content hash and deletion state equal the previous
    version's; the first version's lag is null and its hash is not, so it never is. Folded
    versions share the number of the version they repeat, so they end when it ends.
#}
WITH flagged AS (
    SELECT
        {{ surrogate_key }},
        {{ key }},
        _commit_sequence,
        _valid_from,
        _is_deleted,
        (_content_hash, _is_deleted) IS NOT DISTINCT FROM
            (lag(_content_hash) OVER by_key, lag(_is_deleted) OVER by_key) AS _is_folded
    FROM {{ relation }}
    WHERE {{ key }} IN (SELECT {{ key }} FROM {{ staging }})
    WINDOW by_key AS (PARTITION BY {{ key }} ORDER BY _commit_sequence)
),
numbered AS (
    SELECT
        *,
        count(*) FILTER (WHERE NOT _is_folded) OVER by_key AS version_number
    FROM flagged
    WINDOW by_key AS (PARTITION BY {{ key }} ORDER BY _commit_sequence)
),
versions AS (
    SELECT
        {{ key }},
        version_number,
        lead(_valid_from) OVER by_version AS _valid_to,
        lead(version_number) OVER by_version IS NULL AND NOT _is_deleted AS _is_current
    FROM numbered
    WHERE NOT _is_folded
    WINDOW by_version AS (PARTITION BY {{ key }} ORDER BY version_number)
),
recomputed AS (
    SELECT
        numbered.{{ surrogate_key }},
        numbered._is_folded,
        versions._valid_to,
        versions._is_current AND NOT numbered._is_folded AS _is_current
    FROM numbered
    JOIN versions USING ({{ key }}, version_number)
)
UPDATE {{ relation }} AS stored
SET
    _is_folded = recomputed._is_folded,
    _valid_to = recomputed._valid_to,
    _is_current = recomputed._is_current
FROM recomputed
WHERE stored.{{ surrogate_key }} = recomputed.{{ surrogate_key }}
{% if closing %}
  AND stored._is_current AND NOT recomputed._is_current
{%- else %}
  AND (stored._is_folded, stored._valid_to, stored._is_current)
      IS DISTINCT FROM (recomputed._is_folded, recomputed._valid_to, recomputed._is_current)
{%- endif %}
