{
  "uid": "spark-stages",
  "title": "Spark stages",
  "description": "Historical performance of the completed stages of every Spark application, per application and streaming query, from the stage exporter: durations, skew, CPU and GC, shuffle, spill and data volume.",
  "tags": [
    "spark-and-lake",
    "spark"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(spark_stage_duration_seconds_count, app)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(spark_stage_duration_seconds_count, app)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
        "name": "query",
        "label": "Query",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(spark_stage_duration_seconds_count{app=~\"$app\"}, query)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(spark_stage_duration_seconds_count{app=~\"$app\"}, query)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0,
        "options": [],
        "regex": ""
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Spark and lake",
      "type": "dashboards",
      "tags": [
        "spark-and-lake"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Stages",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Stage duration p50 and p95",
      "description": "Median and 95th percentile time from a stage's submission to its completion, per application and query.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le, app, query) (rate(spark_stage_duration_seconds_bucket{app=~\"$app\", query=~\"$query\"}[$__rate_interval])))",
          "legendFormat": "{{app}} {{query}} p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, app, query) (rate(spark_stage_duration_seconds_bucket{app=~\"$app\", query=~\"$query\"}[$__rate_interval])))",
          "legendFormat": "{{app}} {{query}} p95",
          "range": true
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Skew p95",
      "description": "95th percentile, over the stages, of the slowest task's duration over the median task's (task skew) and of the largest task's bytes read over the median task's (data skew). Above about 3, a few tasks hold the stage back: repartition or salt the key.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, app, query) (rate(spark_stage_task_duration_skew_bucket{app=~\"$app\", query=~\"$query\"}[$__rate_interval])))",
          "legendFormat": "{{app}} {{query}} task duration",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, app, query) (rate(spark_stage_data_skew_bucket{app=~\"$app\", query=~\"$query\"}[$__rate_interval])))",
          "legendFormat": "{{app}} {{query}} data",
          "range": true
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Tasks per stage",
      "description": "Average number of tasks in each stage.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (app, query) (rate(spark_stage_tasks_sum{app=~\"$app\", query=~\"$query\"}[$__rate_interval])) / sum by (app, query) (rate(spark_stage_tasks_count{app=~\"$app\", query=~\"$query\"}[$__rate_interval]))",
          "legendFormat": "{{app}} {{query}}",
          "range": true
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Stages with a median task under 100 ms",
      "description": "Share of stages whose median task took less than 100 ms. A high share means more partitions than the data needs: task scheduling costs more than the work.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (app, query) (rate(spark_stage_median_task_seconds_bucket{app=~\"$app\", query=~\"$query\", le=\"0.1\"}[$__rate_interval])) / sum by (app, query) (rate(spark_stage_median_task_seconds_count{app=~\"$app\", query=~\"$query\"}[$__rate_interval]))",
          "legendFormat": "{{app}} {{query}}",
          "range": true
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
