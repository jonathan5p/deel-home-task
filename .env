# Defaults for Docker Compose interpolation. Variables exported in the shell take precedence.
# The fixed project name keeps every checkout and git worktree on the same local stack.
COMPOSE_PROJECT_NAME=deel_home_task
SPARK_MASTER_URL=spark://spark-master:7077

# Analytics PostgreSQL (gold layer and Iceberg catalog). LOCAL DEVELOPMENT CREDENTIALS ONLY.
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=analytics
ANALYTICS_DB_NAME=analytics

# Service logins of the analytics database, members of the read-only gold_reader role. LOCAL DEVELOPMENT CREDENTIALS ONLY.
API_READER_USER=api_reader
API_READER_PASSWORD=api_reader
GRAFANA_READER_USER=grafana
GRAFANA_READER_PASSWORD=grafana

# The lake REST catalog's read-only login to the Iceberg catalog database. LOCAL DEVELOPMENT CREDENTIALS ONLY.
LAKE_CATALOG_READER_USER=lake_catalog_reader
LAKE_CATALOG_READER_PASSWORD=lake_catalog_reader

# Grafana's admin login. LOCAL DEVELOPMENT CREDENTIALS ONLY.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# SeaweedFS S3 data lake. LOCAL DEVELOPMENT CREDENTIALS ONLY.
LAKE_S3_ACCESS_KEY=lakeadmin
LAKE_S3_SECRET_KEY=lakeadmin-secret

# Where the pipelines run: Kafka, the lake and the analytics database. LOCAL DEVELOPMENT VALUES.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPICS=finance_db.operations.customers,finance_db.operations.products,finance_db.operations.orders,finance_db.operations.order_items
LAKE_ROOT=s3a://lake
ICEBERG_CATALOG=lake
ANALYTICS_DB_URL=jdbc:postgresql://analytics-db:5432/analytics
LAKE_CATALOG_URI=http://iceberg-rest:8181
LAKE_S3_ENDPOINT=http://seaweedfs:8333
LAKE_S3_REGION=us-east-1

# The source database the latency probe marks rows in. LOCAL DEVELOPMENT CREDENTIALS ONLY.
SOURCE_DB_URL=jdbc:postgresql://transactions-db:5432/finance_db
SOURCE_DB_USER=finance_db_user
SOURCE_DB_PASSWORD=1234

# The Spark History Server the stage exporter reads (metrics profile). LOCAL DEVELOPMENT VALUES.
HISTORY_SERVER_URL=http://spark-history:18080

# Micro-batch interval of each pipeline job, in seconds. KEEP IN STEP WITH THE RECORDED TRIGGERS IN
# monitoring/prometheus/rules/spark.yml.
LANDING_TRIGGER_SECONDS=10
BRONZE_TRIGGER_SECONDS=2
SILVER_TRIGGER_SECONDS=2
GOLD_TRIGGER_SECONDS=5
